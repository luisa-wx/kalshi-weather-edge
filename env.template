# NWWS-OI Credentials (case-sensitive, single session only)
# Your user_ID becomes the JID: user_id@nwws-oi-bldr.weather.gov
NWWS_USER_ID=your_user_id_here
NWWS_PASSWORD=your_password_here

# Which NWWS-OI server to connect to
# Boulder (primary after 2/4/2026): nwws-oi-bldr.weather.gov
# College Park (fallback):          nwws-oi-cprk.weather.gov
NWWS_SERVER=nwws-oi-bldr.weather.gov

# --- Future: Kalshi credentials (for snipe execution) ---
# KALSHI_API_KEY_ID=your_key_id
# KALSHI_PRIVATE_KEY=your_pem_key
# LIVE_MODE=false

# --- Future: Wethr API (for situation monitoring) ---
