# WX Sniper systemd service for EC2
# 
# Installation:
#   1. Copy to /etc/systemd/system/wx-sniper.service
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable wx-sniper
#   4. sudo systemctl start wx-sniper
#
# Logs:
#   journalctl -u wx-sniper -f
#
# Status:
#   systemctl status wx-sniper

[Unit]
Description=WX Sniper Temperature Trading Bot
Documentation=https://github.com/your-user/wx-sniper
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# Working directory
WorkingDirectory=/home/ubuntu/wx-sniper

# Load secrets from .env file
EnvironmentFile=/home/ubuntu/wx-sniper/.env

# Runtime configuration
Environment="LIVE_MODE=true"
Environment="MAX_PRICE=95"
Environment="PORT=8080"
Environment="AWS_REGION=us-east-1"
Environment="PYTHONUNBUFFERED=1"

# Run with virtual environment
ExecStart=/home/ubuntu/wx-sniper/venv/bin/python smart_poller.py

# Restart on failure
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wx-sniper

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ReadWritePaths=/tmp /home/ubuntu/wx-sniper

[Install]
WantedBy=multi-user.target
